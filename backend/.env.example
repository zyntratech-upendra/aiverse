# Server Configuration
PORT=4000
NODE_ENV=development

# MongoDB Connection String (Atlas URI or local instance)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Secret & Expiration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Cloudinary Configuration (For Image & Asset Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Nodemailer SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="AI Verse Club <events@aiverse.in>"
EMAIL_REPLY_TO="aiverse@vishnu.edu.in"

# Resend API Secret & Sender (Optional / Primary)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="AI Verse <events@yourdomain.com>"
RESEND_REPLY_TO="aiverse@vishnu.edu.in"

# Client Application URL (For CORS)
CLIENT_URL=http://localhost:5173
